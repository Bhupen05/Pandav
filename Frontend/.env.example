# Copy to .env for local development. In production, set these in the
# hosting provider's environment settings (Vercel: Project > Settings > Environment Variables).

# Backend API URL, including /api
VITE_API_URL=http://localhost:5000/api
# Production, for example:
# VITE_API_URL=https://pandav.onrender.com/api

# Contact details shown on the Contact page. Each one is hidden when unset.
# VITE_CONTACT_EMAIL=support@example.com
# VITE_CONTACT_PHONE=+91 98765 43210
# VITE_CONTACT_WHATSAPP=+91 98765 43210
