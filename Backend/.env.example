# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pandav_db
# For MongoDB Atlas, use: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# Timezone that decides which calendar day an attendance check-in belongs to
# (IANA name, e.g. Asia/Kolkata, Europe/London). Defaults to Asia/Kolkata.
# APP_TIMEZONE=Asia/Kolkata

# CORS Configuration (required in production)
# Origin of the deployed frontend; comma-separate several. localhost:5173 is always allowed.
# CLIENT_URL=https://your-frontend.vercel.app

# Seed accounts for create-users.js (optional; random passwords are generated if unset)
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# API prefixes (the unprefixed /api/* routes stay available as aliases of v1)
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# OAuth Integration (LinkedIn/GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_OAUTH_SCOPE=read:user user:email public_repo

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_OAUTH_SCOPE=openid profile email w_member_social

# Optional GitHub repo fallback for publish endpoint (owner/repo)
GITHUB_DEFAULT_REPO=
